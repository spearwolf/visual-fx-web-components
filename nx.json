{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 8,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build", "^default", "default"],
      "inputs": ["^default", "default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.prettierrc", "{workspaceRoot}/.prettierignore", "{workspaceRoot}/eslint.config.mjs"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default"]
    },
    "buildNpmPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["^build", "build", "default"],
      "options": {
        "script": "buildNpmPkg"
      }
    },
    "publishNpmPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["buildNpmPkg"],
      "options": {
        "script": "publishNpmPkg"
      }
    }
  },
  "analytics": false
}
