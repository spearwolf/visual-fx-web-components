{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 8,
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/.npm-pkg/**/*",
      "!{projectRoot}/.astro/**/*",
      "!{projectRoot}/test-results/**/*",
      "!{projectRoot}/playwright-report/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/testing/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/vitest.shared.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["^default", "default"]
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      },
      "cache": true,
      "dependsOn": ["build", "^build"],
      "inputs": ["^default", "default"]
    },
    "e2e": {
      "executor": "nx:run-script",
      "options": {
        "script": "e2e"
      },
      "cache": true,
      "dependsOn": ["build", "^buildNpmPkg"],
      "inputs": ["^default", "default"]
    },
    "buildNpmPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["^build", "build"],
      "options": {
        "script": "buildNpmPkg"
      }
    },
    "publishNpmPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["buildNpmPkg"],
      "options": {
        "script": "publishNpmPkg"
      }
    }
  },
  "analytics": false
}
