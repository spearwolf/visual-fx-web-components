{
  "name": "@spearwolf/visual-fx-web-components",
  "description": "monorepo",
  "version": "0.0.0",
  "author": "Wolfger Schramm <wolfger@spearwolf.de>",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "nx": "pnpm exec nx",
    "rimraf": "pnpm exec rimraf",
    "run-s": "pnpm exec run-s -s",
    "build": "pnpm nx run-many -t build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm nx run-many -t test",
    "test:affected": "pnpm nx affected -t test e2e",
    "e2e": "pnpm nx run-many -t e2e",
    "playwright:install": "playwright install chromium firefox",
    "playwright:install:webkit": "playwright install webkit",
    "clean": "pnpm nx run-many -t clean && pnpm rimraf dist",
    "clear-cache": "pnpm nx reset && pnpm nx run-many -t clean && pnpm rimraf dist",
    "deps:update": "pnpm dlx npm-check --update",
    "cbt": "pnpm run-s clean build test e2e",
    "make:todo": "pnpm node scripts/makeTODO.mjs TODO.md",
    "verify": "pnpm run-s lint typecheck build test e2e",
    "publishNpmPkg": "pnpm nx run-many -t publishNpmPkg --output-style=static"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vitest/browser-playwright": "^5.0.1",
    "esbuild": "^0.28.2",
    "leasot": "^14.4.0",
    "npm-run-all2": "^9.0.3",
    "nx": "^23.2.1",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
