{
  "name": "@spearwolf/visual-fx-web-components",
  "description": "monorepo",
  "version": "0.0.0",
  "author": "Wolfger Schramm <wolfger@spearwolf.de>",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "nx": "pnpm exec nx",
    "rimraf": "pnpm exec rimraf",
    "run-s": "pnpm exec run-s -s",
    "build": "pnpm nx run-many -t build",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "test:affected": "pnpm nx affected -t test",
    "clean": "pnpm nx run-many -t clean && pnpm rimraf dist",
    "clear-cache": "pnpm nx reset && pnpm nx run-many -t clean && pnpm rimraf dist",
    "update": "pnpm dlx npm-check --update",
    "cbt": "pnpm run-s clean build test",
    "make:todo": "pnpm node scripts/makeTODO.mjs TODO.md",
    "ci": "pnpm run-s build lint test",
    "publishNpmPkg": "pnpm nx run-many -t publishNpmPkg"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^23.2.1",
    "@nx/js": "^23.2.1",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-require-extensions": "^0.1.3",
    "globals": "^17.12.0",
    "leasot": "^14.4.0",
    "npm-run-all2": "^9.0.3",
    "nx": "^23.2.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
