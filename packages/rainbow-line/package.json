{
  "name": "rainbow-line",
  "description": "A custom element that displays a cut line animated with rainbow colors",
  "version": "0.6.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/visual-fx-web-components.git",
    "directory": "packages/rainbow-line"
  },
  "author": {
    "name": "Wolfger Schramm",
    "email": "wolfger@spearwolf.de",
    "url": "https://www.spearwolf.de"
  },
  "main": "bundle.js",
  "module": "bundle.js",
  "exports": {
    ".": {
      "default": "./bundle.js"
    },
    "./bundle.js": {
      "default": "./bundle.js"
    },
    "./RainbowLineElement.js": {
      "types": "./dist/types/RainbowLineElement.d.ts",
      "default": "./src/RainbowLineElement.js"
    },
    "./RainbowLineWorkerDisplay.js": {
      "types": "./dist/types/RainbowLineWorkerDisplay.d.ts",
      "default": "./src/RainbowLineWorkerDisplay.js"
    },
    "./rainbow-line.js": {
      "default": "./rainbow-line.js"
    },
    "./rainbow-line.worker.js": {
      "default": "./rainbow-line.worker.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm node scripts/build.mjs && pnpm exec tsc -p tsconfig.build.json",
    "build:pkg:prepare": "pnpm node ./scripts/buildPackage.mjs",
    "build:pkg:json": "pnpm node ../../scripts/makePackageJson.mjs",
    "build:pkg:clean": "pnpm exec rimraf .npm-pkg",
    "clean": "pnpm exec rimraf dist bundle.js rainbow-line.js rainbow-line.worker.js .npm-pkg",
    "deps:update": "pnpm dlx npm-check --update",
    "buildNpmPkg": "pnpm exec run-s build:pkg:clean build:pkg:prepare build:pkg:json",
    "publishNpmPkg": "pnpm node ../../scripts/publishNpmPkg.mjs .npm-pkg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@spearwolf/eventize": "^6.2.0",
    "@spearwolf/offscreen-display": "workspace:*",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "@spearwolf/eventize": "^6.2.0",
    "@spearwolf/offscreen-display": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@spearwolf/eventize": {
      "optional": true
    },
    "@spearwolf/offscreen-display": {
      "optional": true
    }
  }
}
