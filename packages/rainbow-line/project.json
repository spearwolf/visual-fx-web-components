{
  "name": "rainbow-line",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/rainbow-line",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "outputs": [
        "{projectRoot}/bundle.js",
        "{projectRoot}/rainbow-line.js",
        "{projectRoot}/rainbow-line.worker.js",
        "{projectRoot}/dist"
      ]
    },
    "buildNpmPkg": {
      "outputs": ["{projectRoot}/.npm-pkg"]
    }
  },
  "tags": [],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.npm-pkg/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/bundle.js",
      "!{projectRoot}/rainbow-line.js",
      "!{projectRoot}/rainbow-line.worker.js",
      "sharedGlobals"
    ]
  }
}
